//sender side 
#include <iostream>
#include <string>
using namespace std;
int main()
{
    string data;
    cout << "========== SENDER SIDE ==========" << endl;
    cout << "Enter data bits: ";
    cin >> data;
    for (char c : data)
{
    if (c != '0' && c != '1')
        {
            cout << "Invalid input! Enter only 0 and 1." << endl;
            return 0;
        }
    }
int m = data.length();
   int r = 0;

    while ((1 << r) < (m + r + 1))
    {
        r++;
    }
  int n = m + r;
  int h[100] = {0};
  int j = 0;
    for (int i = 1; i <= n; i++)
    {
        if ((i & (i - 1)) != 0)
        {
       h[i] = data[j] - '0';
            j++;
        }
    }
    for (int p = 1; p <= n; p = p * 2)
    {
        int parity = 0;
        for (int i = 1; i <= n; i++)
        {
            if ((i & p) != 0)
            {
                parity = parity ^ h[i];
            }
        }
        h[p] = parity;
    }
    cout << "\nNumber of Data Bits = " << m;
    cout << "\nNumber of Redundant Bits = " << r;
    cout << "\nTotal Bits = " << n << endl;
    cout << "\nRedundant Bits:" << endl;
    for (int p = 1; p <= n; p = p * 2)
    {
        cout << "R" << p << " = " << h[p] << endl;
    }
    cout << "\nHamming Code = ";
    for (int i = n; i >= 1; i--)
    {
        cout << h[i];
    }
    cout << endl;
    return 0;
}

